# Server Health Monitor - Environment Variable Configuration
# Copy this file to .env and adjust values as needed.
# All variables are optional and override configuration file and default settings.

# ============================================================
# Threshold Configuration
# ============================================================

# CPU usage percentage thresholds
SERVER_HEALTH_CPU_WARNING=70
SERVER_HEALTH_CPU_CRITICAL=90

# Memory (RAM) usage percentage thresholds
SERVER_HEALTH_MEMORY_WARNING=75
SERVER_HEALTH_MEMORY_CRITICAL=90

# Disk usage percentage thresholds
SERVER_HEALTH_DISK_WARNING=80
SERVER_HEALTH_DISK_CRITICAL=90

# Load average thresholds (1-minute load relative to cores)
SERVER_HEALTH_LOAD_WARNING=2.0
SERVER_HEALTH_LOAD_CRITICAL=4.0

# ============================================================
# Application Settings
# ============================================================

# Number of top processes to display by CPU and memory
SERVER_HEALTH_TOP_PROCESSES=5

# Comma-separated list of systemd services to monitor
SERVER_HEALTH_SERVICES=ssh,sshd,docker,nginx,cron

# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SERVER_HEALTH_LOG_LEVEL=INFO
