[Unit]
Description=Linux Server Health Monitor - Periodic Timer
Documentation=https://github.com/TORNADO984/Linux-Server-Health-Monitor

[Timer]
# Run every 15 minutes
OnCalendar=*:0/15

# Trigger immediately if missed during server reboot
Persistent=true

# Add jitter to prevent thundering herd when deployed across fleet
RandomizedDelaySec=30

Unit=server-health.service

[Install]
WantedBy=timers.target
